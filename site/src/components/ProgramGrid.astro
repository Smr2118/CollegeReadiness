---
// Programs are loaded from Supabase at runtime — filtered by season
---

<!-- Archived banner (shown when viewing 2026) -->
<div class="archived-banner" id="pg-archived-banner" style="display:none">
  Viewing archived Summer 2026 programs — reference only.
</div>

<p class="results-count" id="pg-count">Loading…</p>

<div class="program-grid" id="pg-grid">
  <p id="pg-loading" style="color:var(--sl-color-gray-2);padding:2rem 0">Loading programs…</p>
</div>

<p id="pg-empty" style="display:none; color:var(--sl-color-gray-2); margin-top:2rem;">
  No programs match your filters. Try broadening your search.
</p>

<!-- Full-screen modal -->
<div id="pg-modal" class="prog-modal" style="display:none" role="dialog" aria-modal="true" aria-labelledby="pg-modal-title">
  <div class="prog-modal__backdrop" id="pg-modal-backdrop"></div>
  <div class="prog-modal__panel">
    <button class="prog-modal__close" id="pg-modal-close" aria-label="Close">✕</button>
    <div class="prog-modal__body" id="pg-modal-body"></div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase';

  function esc(s: string | null | undefined): string {
    return (s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Compact card (header + interest row only) ────────────────────────────
  function makeCard(p: any): string {
    const statusLabel: Record<string,string> = {
      open:'Open', closed:'Closed', nextyear:'Next Year', conflict:'Conflict'
    };
    const interestKey = `pc-interest-${p.name}`;
    const savedInt    = localStorage.getItem(interestKey) ?? '';
    const iv = (v: string) => savedInt === v ? ' active' : '';
    const chipDisabled = isReadOnly ? ' disabled' : '';

    return `<div class="program-card"
      data-tier="${p.tier}"
      data-category="${esc(p.category)}"
      data-status="${esc(p.status)}"
      data-cost="${esc(p.cost)}"
      data-format="${esc(p.format)}"
      data-name="${esc((p.name ?? '').toLowerCase())}"
      data-tags="${esc((p.tags ?? []).join(' ').toLowerCase())}"
      data-org="${esc((p.org ?? '').toLowerCase())}"
      data-deadline="${esc(p.deadline ?? '')}"
      data-interest="${esc(savedInt)}"
      data-interest-key="${esc(interestKey)}"
      data-note-type="${esc(p.note_type ?? '')}">

      <button class="program-card__toggle" data-open-name="${esc(p.name)}">
        <div class="program-card__toggle-left">
          <p class="program-card__name">${esc(p.name)}</p>
          <p class="program-card__org">${esc(p.org)}</p>
          <span class="program-card__fit-badge"${p.note_type !== 'warning' ? ' style="visibility:hidden"' : ''}>${p.status === 'conflict' ? '⛔ Not eligible' : '⚠️ Reduced fit'}</span>
        </div>
        <div class="program-card__toggle-right">
          <span class="badge badge--${esc(p.status)}">${esc(statusLabel[p.status] ?? p.status)}</span>
          <span class="program-card__chevron">›</span>
        </div>
      </button>

      <div class="program-card__interest-row">
        <span class="program-card__interest-label">Interest:</span>
        <select class="interest-select"${chipDisabled} data-interest-key="${esc(interestKey)}">
          <option value="">—</option>
          <option value="applied"${savedInt === 'applied' ? ' selected' : ''}>✅ Applied</option>
          <option value="applying"${savedInt === 'applying' ? ' selected' : ''}>🔥 Applying</option>
          <option value="researching"${savedInt === 'researching' ? ' selected' : ''}>👀 Researching</option>
          <option value="maybe"${savedInt === 'maybe' ? ' selected' : ''}>🤔 Maybe</option>
          <option value="skip"${savedInt === 'skip' ? ' selected' : ''}>❌ Skip</option>
        </select>
      </div>
    </div>`;
  }

  // ── Modal body ────────────────────────────────────────────────────────────
  function makeModalBody(p: any): string {
    const statusLabel: Record<string,string> = {
      open:'Open', closed:'Closed', nextyear:'Apply Next Year', conflict:'Conflict'
    };
    const tierLabel: Record<number,string> = {
      1:'T1 – Elite', 2:'T2 – Highly Selective', 3:'T3 – Moderate', 4:'T4 – Accessible'
    };
    const r = Math.round(p.rating ?? 0);
    const stars = '★'.repeat(r) + '☆'.repeat(5 - r);
    const costKey = (p.cost ?? '').toLowerCase().replace('/','').replace(' ','');
    const interestKey = `pc-interest-${p.name}`;
    const noteKey     = `pc-note-${p.name}`;
    const savedNote   = localStorage.getItem(noteKey) ?? '';
    const savedInt    = localStorage.getItem(interestKey) ?? '';
    const iv = (v: string) => savedInt === v ? ' active' : '';
    const chipDisabled = isReadOnly ? ' disabled' : '';
    const noteReadonly = isReadOnly ? ' readonly' : '';

    const tagsHtml = (p.tags ?? []).map((t: string) =>
      `<span class="badge badge--tag">${esc(t)}</span>`).join('');

    const noteTypeLabel: Record<string,string> = {
      priority: '🚨 Priority', deadline: '⏰ Deadline Note',
      info: 'ℹ️ Info', warning: '⚠️ Note', conflict: '⚡ Conflict', nextyear: '📅 Next Year'
    };
    const toBullets = (text: string) => {
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      if (lines.length <= 1) return `<p>${esc(text)}</p>`;
      return `<ul class="prog-modal__bullets">${lines.map(l => `<li>${esc(l)}</li>`).join('')}</ul>`;
    };
    const noteHtml = p.note ? `
      <div class="prog-modal__note prog-modal__note--${esc(p.note_type ?? 'info')}">
        <div class="prog-modal__note-label">${noteTypeLabel[p.note_type ?? 'info'] ?? 'ℹ️ Note'}</div>
        ${toBullets(p.note)}
      </div>` : '';

    const applyBtn = p.url && p.url.startsWith('http')
      ? `<a class="prog-modal__apply-btn" href="${esc(p.url)}" target="_blank" rel="noopener">Apply →</a>`
      : '';

    return `
      <div class="prog-modal__header">
        <div>
          <h2 class="prog-modal__title" id="pg-modal-title">${esc(p.name)}</h2>
          <p class="prog-modal__org">${esc(p.org)}</p>
        </div>
        <span class="badge badge--${esc(p.status)} prog-modal__status">${esc(statusLabel[p.status] ?? p.status)}</span>
      </div>

      <div class="prog-modal__meta">
        <span class="badge badge--tier${p.tier}">${esc(tierLabel[p.tier] ?? '')}</span>
        <span class="badge badge--${esc(costKey)}">${esc(p.cost)}</span>
        <span class="badge badge--format">${esc(p.format)}</span>
        <span class="badge badge--format">📅 ${esc(p.duration)}</span>
        <span class="badge badge--format">🎓 ${esc(p.grades)}</span>
      </div>

      <div class="prog-modal__stars">
        <span class="stars">${stars}</span>
        <span>${esc(p.selectivity_label)}</span>
        <span class="prog-modal__impact">· College Impact: <strong>${esc(p.college_impact_label)}</strong></span>
      </div>

      <div class="prog-modal__section">
        <h3 class="prog-modal__section-title">About</h3>
        ${toBullets(p.description ?? '')}
      </div>

      ${noteHtml}

      ${tagsHtml ? `<div class="prog-modal__tags">${tagsHtml}</div>` : ''}

      <div class="prog-modal__section">
        <h3 class="prog-modal__section-title">My Interest</h3>
        <div class="prog-modal__interest-row">
          <select class="interest-select"${chipDisabled} data-interest-key="${esc(interestKey)}">
            <option value="">—</option>
            <option value="applied"${savedInt === 'applied' ? ' selected' : ''}>✅ Applied</option>
            <option value="applying"${savedInt === 'applying' ? ' selected' : ''}>🔥 Applying</option>
            <option value="researching"${savedInt === 'researching' ? ' selected' : ''}>👀 Researching</option>
            <option value="maybe"${savedInt === 'maybe' ? ' selected' : ''}>🤔 Maybe</option>
            <option value="skip"${savedInt === 'skip' ? ' selected' : ''}>❌ Skip</option>
          </select>
        </div>
      </div>

      <div class="prog-modal__section">
        <h3 class="prog-modal__section-title">My Notes</h3>
        <textarea class="program-card__user-note prog-modal__notes"
          data-key="${esc(noteKey)}"
          placeholder="Add your notes, application status, reminders…"
          rows="4"${noteReadonly}>${esc(savedNote)}</textarea>
      </div>

      <div class="prog-modal__footer">
        <span class="prog-modal__deadline">⏰ ${esc(p.deadline)}</span>
        ${applyBtn}
      </div>`;
  }

  // ── Modal open / close ───────────────────────────────────────────────────
  let activeModalName = '';

  function openModal(name: string) {
    const p = allPrograms.find(x => x.name === name);
    if (!p) return;
    activeModalName = name;

    document.getElementById('pg-modal-body')!.innerHTML = makeModalBody(p);
    const modal = document.getElementById('pg-modal')!;
    modal.style.display = '';
    document.body.style.overflow = 'hidden';
    document.getElementById('pg-modal-close')?.focus();
  }

  function closeModal() {
    document.getElementById('pg-modal')!.style.display = 'none';
    document.body.style.overflow = '';
    activeModalName = '';
  }

  document.getElementById('pg-modal-close')!.addEventListener('click', closeModal);
  document.getElementById('pg-modal-backdrop')!.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // ── Readonly mode ────────────────────────────────────────────────────────
  let isReadOnly = document.body.dataset.readonly === 'true';

  document.addEventListener('app-readonly-state', (e: Event) => {
    isReadOnly = (e as CustomEvent).detail?.isReadOnly === true;
  });

  // ── Program data store ───────────────────────────────────────────────────
  let allPrograms: any[] = [];
  let currentSeason = 'Summer 2027';

  // ── Filter state ─────────────────────────────────────────────────────────
  const active: Record<string, Set<string>> = {
    status:   new Set(['open']),
    tier:     new Set(['all']),
    cost:     new Set(['all']),
    format:   new Set(['all']),
    category: new Set(['all']),
    interest: new Set(['all']),
  };
  let query  = '';
  let sortBy = 'default';
  let originalOrder: Element[] = [];

  function resetFilterState() {
    active.status   = new Set(['open']);
    active.tier     = new Set(['all']);
    active.cost     = new Set(['all']);
    active.format   = new Set(['all']);
    active.category = new Set(['all']);
    active.interest = new Set(['all']);
    query  = '';
    sortBy = 'default';
    document.querySelectorAll<HTMLElement>('.filter-chip').forEach(c => {
      const f = c.dataset.filter!;
      const v = c.dataset.value!;
      c.classList.toggle('active', active[f]?.has(v) ?? false);
    });
    const searchEl = document.getElementById('pg-search') as HTMLInputElement | null;
    if (searchEl) searchEl.value = '';
    const sortEl = document.getElementById('pg-sort') as HTMLSelectElement | null;
    if (sortEl) sortEl.value = 'default';
  }

  // ── Filter / Sort ────────────────────────────────────────────────────────
  function parseDeadline(text: string | null | undefined): number {
    if (!text) return Infinity;
    const m = text.match(/([A-Z][a-z]+ \d{1,2},?\s*\d{4})/);
    if (m) { const d = new Date(m[1]); if (!isNaN(d.getTime())) return d.getTime(); }
    return Infinity;
  }

  const interestOrder: Record<string,number> = { applied:0, applying:1, researching:2, maybe:3, '':4, skip:5 };
  const fitOrder: Record<string,number> = { priority: 0, info: 1, warning: 2 };

  function sortCards() {
    const grid = document.getElementById('pg-grid')!;
    const cards = Array.from(grid.querySelectorAll('.program-card'));
    if (sortBy === 'default') {
      const origIdx = new Map(originalOrder.map((el, i) => [el as HTMLElement, i]));
      cards.sort((a, b) => {
        const fa = fitOrder[(a as HTMLElement).dataset.noteType ?? ''] ?? 1;
        const fb = fitOrder[(b as HTMLElement).dataset.noteType ?? ''] ?? 1;
        if (fa !== fb) return fa - fb;
        return (origIdx.get(a as HTMLElement) ?? 99) - (origIdx.get(b as HTMLElement) ?? 99);
      });
      cards.forEach(c => grid.appendChild(c));
      return;
    }
    if (sortBy === 'deadline') {
      cards.sort((a,b) => parseDeadline((a as HTMLElement).dataset.deadline) - parseDeadline((b as HTMLElement).dataset.deadline));
    } else if (sortBy === 'interest') {
      cards.sort((a,b) => {
        const ia = interestOrder[(a as HTMLElement).dataset.interest ?? ''] ?? 3;
        const ib = interestOrder[(b as HTMLElement).dataset.interest ?? ''] ?? 3;
        return ia - ib;
      });
    }
    cards.forEach(c => grid.appendChild(c));
  }

  function applyFilters() {
    const grid    = document.getElementById('pg-grid')!;
    const countEl = document.getElementById('pg-count')!;
    const emptyEl = document.getElementById('pg-empty')!;
    let visible = 0;
    grid.querySelectorAll<HTMLElement>('.program-card').forEach(el => {
      const matches =
        (active.status.has('all')   || active.status.has(el.dataset.status   ?? '')) &&
        (active.tier.has('all')     || active.tier.has(el.dataset.tier       ?? '')) &&
        (active.cost.has('all')     || active.cost.has(el.dataset.cost       ?? '')) &&
        (active.format.has('all')   || active.format.has(el.dataset.format   ?? '')) &&
        (active.category.has('all') || active.category.has(el.dataset.category ?? '')) &&
        (active.interest.has('all') || active.interest.has(el.dataset.interest ?? '')) &&
        (query === '' ||
          (el.dataset.name  ?? '').includes(query) ||
          (el.dataset.org   ?? '').includes(query) ||
          (el.dataset.tags  ?? '').includes(query));
      el.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });
    countEl.textContent = `${visible} program${visible !== 1 ? 's' : ''}`;
    emptyEl.style.display = visible === 0 ? '' : 'none';
  }

  function refresh() { sortCards(); applyFilters(); }

  // ── Load season from Supabase ────────────────────────────────────────────
  async function loadSeason(season: string) {
    currentSeason = season;
    const grid = document.getElementById('pg-grid')!;
    grid.innerHTML = '<p id="pg-loading" style="color:var(--sl-color-gray-2);padding:2rem 0">Loading programs…</p>';
    document.getElementById('pg-count')!.textContent = 'Loading…';
    document.getElementById('pg-empty')!.style.display = 'none';
    document.getElementById('pg-archived-banner')!.style.display = season === 'Summer 2026' ? '' : 'none';

    const { data, error } = await supabase
      .from('programs')
      .select('*')
      .eq('season', season)
      .order('sort_order', { ascending: true });

    document.getElementById('pg-loading')?.remove();

    if (error) {
      grid.innerHTML = `<p style="color:var(--sl-color-red)">Failed to load programs: ${error.message}</p>`;
      return;
    }

    if (!data || data.length === 0) {
      grid.innerHTML = '';
      document.getElementById('pg-count')!.textContent = '0 programs';
      const emptyEl = document.getElementById('pg-empty')!;
      emptyEl.textContent = season === 'Summer 2027'
        ? 'No programs added yet for Summer 2027. Use the Admin Panel → Programs to add new programs.'
        : 'No archived programs found for this season.';
      emptyEl.style.display = '';
      return;
    }

    allPrograms   = data;
    grid.innerHTML = data.map(makeCard).join('');
    originalOrder  = Array.from(grid.querySelectorAll('.program-card'));
    document.getElementById('pg-count')!.textContent = `${data.length} programs`;
    resetFilterState();
    refresh();
    document.dispatchEvent(new Event('data-loaded'));
  }

  // ── Season switcher ──────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.season-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const season = btn.dataset.season!;
      if (season === currentSeason) return;
      document.querySelectorAll<HTMLButtonElement>('.season-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.season === season);
      });
      loadSeason(season);
    });
  });

  // ── Event delegation ─────────────────────────────────────────────────────

  // Card header → open modal
  document.addEventListener('click', e => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.program-card__toggle');
    if (!btn) return;
    openModal(btn.dataset.openName!);
  });

  // Interest select (card row OR modal row)
  document.addEventListener('change', e => {
    const sel = (e.target as Element).closest<HTMLSelectElement>('.interest-select');
    if (!sel) return;
    if (isReadOnly) return;

    const interestKey = sel.dataset.interestKey ?? '';
    if (!interestKey) return;
    const val = sel.value;
    localStorage.setItem(interestKey, val);

    // Update card data-interest + sync its select
    const cardEl = document.querySelector<HTMLElement>(`.program-card[data-interest-key="${interestKey}"]`);
    if (cardEl) {
      cardEl.dataset.interest = val;
      const cardSel = cardEl.querySelector<HTMLSelectElement>('.interest-select');
      if (cardSel && cardSel !== sel) cardSel.value = val;
    }

    // Sync modal select if open
    const modalSel = document.querySelector<HTMLSelectElement>('.prog-modal__interest-row .interest-select');
    if (modalSel && modalSel.dataset.interestKey === interestKey && modalSel !== sel) {
      modalSel.value = val;
    }

    document.dispatchEvent(new CustomEvent('interest-changed', {
      detail: { programName: interestKey.replace('pc-interest-', ''), interest: val }
    }));
  });

  // localStorage notes
  document.addEventListener('input', e => {
    const ta = e.target as HTMLTextAreaElement;
    if (!ta.classList.contains('program-card__user-note')) return;
    if (isReadOnly) return;
    if (ta.dataset.key) localStorage.setItem(ta.dataset.key, ta.value);
  });

  // Filter chips
  document.addEventListener('click', e => {
    const chip = (e.target as Element).closest<HTMLElement>('.filter-chip[data-filter]');
    if (!chip) return;
    const filter = chip.dataset.filter!;
    const value  = chip.dataset.value!;
    const current = active[filter];

    if (value === 'all') {
      current.clear(); current.add('all');
    } else {
      current.delete('all');
      if (current.has(value)) {
        current.delete(value);
        if (current.size === 0) current.add('all');
      } else {
        current.add(value);
      }
    }

    document.querySelectorAll<HTMLElement>(`.filter-chip[data-filter="${filter}"]`).forEach(c => {
      c.classList.toggle('active', current.has(c.dataset.value ?? ''));
    });
    applyFilters();
  });

  // Sort dropdown
  document.addEventListener('change', e => {
    const sel = e.target as HTMLSelectElement;
    if (sel.id !== 'pg-sort') return;
    sortBy = sel.value; refresh();
  });

  // Search (debounced)
  let debounceTimer: ReturnType<typeof setTimeout>;
  document.addEventListener('input', e => {
    const el = e.target as HTMLInputElement;
    if (el.id !== 'pg-search') return;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => { query = el.value.toLowerCase().trim(); applyFilters(); }, 200);
  });

  document.addEventListener('interest-changed', applyFilters);
  document.addEventListener('data-loaded', refresh);

  // ── CSV Export ───────────────────────────────────────────────────────────
  function csvCell(val: any): string {
    const s = (val ?? '').toString().replace(/"/g, '""');
    return `"${s}"`;
  }

  document.addEventListener('click', e => {
    if ((e.target as Element).id !== 'pg-export') return;
    const grid = document.getElementById('pg-grid')!;
    const visibleNames = new Set(
      Array.from(grid.querySelectorAll<HTMLElement>('.program-card'))
        .filter(el => el.style.display !== 'none')
        .map(el => el.dataset.name ?? '')
    );
    const tierLabel: Record<number,string> = {
      1:'T1 – Elite', 2:'T2 – Highly Selective', 3:'T3 – Moderate', 4:'T4 – Accessible'
    };
    const rows = allPrograms.filter(p => visibleNames.has((p.name ?? '').toLowerCase()));
    const headers = ['Name','Org','Status','Tier','Cost','Format','Duration','Grades',
                     'Deadline','Category','Tags','My Interest','Season','URL','Description'];
    const lines = [
      headers.map(csvCell).join(','),
      ...rows.map(p => {
        const interest = localStorage.getItem(`pc-interest-${p.name}`) ?? '';
        return [p.name, p.org, p.status, tierLabel[p.tier] ?? p.tier, p.cost, p.format,
                p.duration, p.grades, p.deadline, p.category, (p.tags ?? []).join('; '),
                interest, p.season ?? '', p.url, p.description].map(csvCell).join(',');
      })
    ];
    const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = `summer-programs-${currentSeason.replace(' ','-')}.csv`;
    a.click(); URL.revokeObjectURL(url);
  });

  loadSeason('Summer 2027');
</script>
