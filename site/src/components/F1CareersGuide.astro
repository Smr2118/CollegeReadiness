<script>
  const guide = document.getElementById('f1-guide');
  if (!guide) throw new Error('f1-guide not found');

  // Tab switching
  guide.querySelectorAll<HTMLButtonElement>('.f1g-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      if (!tab) return;
      guide.querySelectorAll('.f1g-tab').forEach(t => {
        t.classList.remove('f1g-tab--on');
        t.setAttribute('aria-selected', 'false');
      });
      guide.querySelectorAll('.f1g-panel').forEach(p => p.classList.add('f1g-panel--hide'));
      btn.classList.add('f1g-tab--on');
      btn.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(`f1g-${tab}`);
      if (panel) panel.classList.remove('f1g-panel--hide');
    });
  });

  // Department accordions
  guide.querySelectorAll<HTMLButtonElement>('.f1g-dept-hdr').forEach(btn => {
    btn.addEventListener('click', () => {
      const deptId = btn.dataset.dept;
      if (!deptId) return;
      const body = document.getElementById(`f1g-dept-${deptId}`);
      if (!body) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (isOpen) {
        body.hidden = true;
      } else {
        body.hidden = false;
      }
    });
  });

  // Path track switching
  guide.querySelectorAll<HTMLButtonElement>('.f1g-track-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const track = btn.dataset.track;
      if (!track) return;
      guide.querySelectorAll('.f1g-track-btn').forEach(b => b.classList.remove('f1g-track-btn--on'));
      guide.querySelectorAll('.f1g-track').forEach(t => t.classList.add('f1g-track--hide'));
      btn.classList.add('f1g-track-btn--on');
      const panel = document.getElementById(`f1g-track-${track}`);
      if (panel) panel.classList.remove('f1g-track--hide');
    });
  });
</script>
