</style>

<script>
  const guide = document.getElementById('f1-guide');
  if (!guide) throw new Error('f1-guide not found');

  // Tab switching
  guide.querySelectorAll<HTMLButtonElement>('.f1g-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      if (!tab) return;
      guide.querySelectorAll('.f1g-tab').forEach(t => {
        t.classList.remove('f1g-tab--on');
        t.setAttribute('aria-selected', 'false');
      });
      guide.querySelectorAll('.f1g-panel').forEach(p => p.classList.add('f1g-panel--hide'));
      btn.classList.add('f1g-tab--on');
      btn.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(`f1g-${tab}`);
      if (panel) panel.classList.remove('f1g-panel--hide');
    });
  });

  // Department accordions
  guide.querySelectorAll<HTMLButtonElement>('.f1g-dept-hdr').forEach(btn => {
    btn.addEventListener('click', () => {
      const deptId = btn.dataset.dept;
      if (!deptId) return;
      const body = document.getElementById(`f1g-dept-${deptId}`);
      if (!body) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (isOpen) {
        body.hidden = true;
      } else {
        body.hidden = false;
      }
    });
  });

  // Path track switching
  guide.querySelectorAll<HTMLButtonElement>('.f1g-track-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const track = btn.dataset.track;
      if (!track) return;
      guide.querySelectorAll('.f1g-track-btn').forEach(b => b.classList.remove('f1g-track-btn--on'));
      guide.querySelectorAll('.f1g-track').forEach(t => t.classList.add('f1g-track--hide'));
      btn.classList.add('f1g-track-btn--on');
      const panel = document.getElementById(`f1g-track-${track}`);
      if (panel) panel.classList.remove('f1g-track--hide');
    });
  });

  // Role path selector
  const rpSelect = document.getElementById('f1g-rp-select') as HTMLSelectElement | null;
  const rpClear  = document.getElementById('f1g-rp-clear') as HTMLButtonElement | null;
  const genericTracks = document.getElementById('f1g-generic-tracks');
  const orDivider     = document.getElementById('f1g-or-divider');

  function showRolePath(role: string) {
    guide.querySelectorAll<HTMLElement>('.f1g-rp-path').forEach(p => { p.hidden = true; });
    if (role) {
      const el = guide.querySelector<HTMLElement>(`.f1g-rp-path[data-role="${role}"]`);
      if (el) el.hidden = false;
      if (genericTracks) genericTracks.style.display = 'none';
      if (orDivider) orDivider.style.display = 'none';
      if (rpClear) rpClear.hidden = false;
    } else {
      if (genericTracks) genericTracks.style.display = '';
      if (orDivider) orDivider.style.display = '';
      if (rpClear) rpClear.hidden = true;
    }
  }

  rpSelect?.addEventListener('change', () => showRolePath(rpSelect.value));

  rpClear?.addEventListener('click', () => {
    if (rpSelect) rpSelect.value = '';
    showRolePath('');
  });

  // "Map My Path" buttons on role cards
  guide.addEventListener('click', e => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.f1g-map-btn');
    if (!btn) return;
    const role = btn.dataset.role;
    if (!role) return;

    // Switch to path tab
    const pathTab = guide.querySelector<HTMLButtonElement>('.f1g-tab[data-tab="path"]');
    pathTab?.click();

    // Set dropdown and show path
    if (rpSelect) rpSelect.value = role;
    showRolePath(role);

    // Scroll to path panel
    setTimeout(() => {
      document.getElementById('f1g-path')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 50);
  });
</script>
