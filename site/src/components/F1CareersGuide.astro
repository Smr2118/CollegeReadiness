  .f1g-meta-item { display: flex; flex-direction: column; gap: 0.1rem; flex: 1; min-width: 150px; }
  .f1g-meta-lbl { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3, #9ca3af); }
  .f1g-meta-val { font-size: 0.82rem; color: var(--sl-color-text, #111); }
