---
interface Role {
  title: string;
  entry: string;
  degree: string;
  mastersRequired: boolean;
  demand: 'very-high' | 'high' | 'medium' | 'low';
  tools: string[];
  description: string;
}
interface Department {
  id: string;
  icon: string;
  name: string;
  tagline: string;
  roles: Role[];
}
interface MastersProgram {
  name: string;
  uni: string;
  location: string;
  duration: string;
  focus: string;
  modules: string[];
  cost: string;
  f1Score: number;
  standout: string;
  url: string;
}
interface F1Team {
  name: string;
  base: string;
  color: string;
  focus: string;
  url: string;
  usAccessible: boolean;
  note?: string;
}

