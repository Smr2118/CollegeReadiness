    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: #fff;
    border: none;
    padding: 0;
  }
  .f1g-hero-sub { font-size: 0.9rem; opacity: 0.85; margin: 0; line-height: 1.6; }
