    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .f1g-note { font-size: 0.8rem; color: var(--sl-color-gray-3, #6b7280); margin: 0.25rem 0 0.75rem; }
