    min-width: 70px;
  }
  .f1g-stat-num { font-size: 1.4rem; font-weight: 700; color: #e10600; }
  .f1g-stat-lbl { font-size: 0.65rem; opacity: 0.75; text-align: center; margin-top: 0.15rem; }

  /* ── Tabs ──────────────────────────────────────────────────────────────── */
  .f1g-tabs {
    display: flex;
    gap: 0.25rem;
